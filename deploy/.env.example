# fusion-k12-teacher v2.0 集群部署环境变量示例
# 复制为 .env 并填充真实值。标记 (必填) 的缺失会 fail-closed。

# ── 部署形态 ──
# standalone (默认, 单实例 SQLite) | cluster (多实例 Postgres+Redis, 水平扩缩容)
FUSION_K12_MODE=cluster

# ── 鉴权 (必填) ──
# 受保护端点 API key (X-API-Key header); fail-closed: 未配置拒所有受保护端点
FUSION_K12_API_KEY=change-me-k12-api-key
# 管理员 key (audit/metrics/export 等敏感写接口); fail-closed: 未配置禁用
FUSION_K12_ADMIN_API_KEY=change-me-k12-admin-key

# ── LLM 网关对接 (上游 fusion-gateway) ──
# fusion-gateway 地址 (负载均衡 + 鉴权 + 限流, 上游已有能力)
FUSION_MLX_URL=http://fusion-gateway:11432/v1
# 网关 Bearer API key (k12 透传 Authorization: Bearer <key>)
FUSION_MLX_API_KEY=change-me-gateway-bearer-key
# 默认聊天模型 (可热更新)
FUSION_MLX_MODEL=Qwen3.5-9B-4bit
FUSION_MLX_MAX_CONCURRENCY=4
FUSION_MLX_CONNECT_TIMEOUT=10
FUSION_MLX_READ_TIMEOUT=120
FUSION_MLX_MAX_RETRIES=2

# ── 限流 (可热更新: FUSION_K12_RATE_LIMIT) ──
FUSION_K12_RATE_WINDOW=60
FUSION_K12_RATE_MAX=60

# ── 配置热更 (issue #27: 白名单 key 改动保存即生效, 免滚动重启) ──
# 容器内路径 — docker-compose 已挂载 ../config/runtime 到 /app/config/runtime
FUSION_K12_CONFIG_FILE=/app/config/runtime

# ── 集群后端 (cluster 模式必填) ──
# Postgres DSN (asyncpg)
FUSION_K12_PG_DSN=postgresql://k12:change-me@postgres:5432/k12
# Redis (共享限流/缓存/会话)
FUSION_K12_REDIS_URL=redis://redis:6379/0
# 调度器持久化 DB (APScheduler+SQLite, cluster 模式行锁去重)
FUSION_K12_SCHEDULER_DB=/data/scheduler.sqlite
FUSION_K12_TASK_LOCK_TTL=300

# ── 脱敏 salt (可热更新: FUSION_K12_SALT) ──
FUSION_K12_SALT=change-me-32-char-random-salt

# ── 运维 ──
FUSION_K12_LOG_LEVEL=INFO
# 优雅排水超时 (SIGTERM → 拒新 → 等在途 → 超时强退), 秒
FUSION_K12_DRAIN_TIMEOUT=30

# ── 扩缩容 (k8s HPA 用, 非应用读取) ──
FUSION_K12_REPLICAS=3
FUSION_K12_MIN_REPLICAS=2

# ── 双形态开关 (迁移评估 architecture/fusion-k12-teacher-2-ubuntu-1012.md) ──
# 集群部署默认 cloud 形态: LLM/TTS/ASR 全部指向 OpenAI 兼容云端点。
# =1 → ① 不注入 chat_template_kwargs (严格云厂商 4xx 拒绝未知字段)
#      ② 不传 GBNF grammar (mlx 专属) ③ auto-select 禁用, 必须显式 FUSION_MLX_MODEL
FUSION_MLX_CLOUD=1
# FUSION_MLX_URL=https://api.deepseek.com/v1
# FUSION_MLX_MODEL=deepseek-chat
# FUSION_MLX_API_KEY=sk-xxx
# TTS/ASR 独立端点 (可指向不同厂商; 未设置则同主端点)
# FUSION_MLX_TTS_MODEL=tts-1
# FUSION_MLX_ASR_URL=https://<asr-provider>/v1
# FUSION_MLX_ASR_KEY=sk-xxx
# FUSION_MLX_ASR_MODEL=whisper-1
# 健康看门狗探测间隔秒 (serve 后台探针, down 时 WARNING)
FUSION_K12_HEALTH_PROBE_INTERVAL=60
