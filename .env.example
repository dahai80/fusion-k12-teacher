# Fusion-K12-Teacher 数字人模块环境配置示例
# 复制为 .env 并填入真实值; 缺失时数字人降级为 WS-only (TTS音频+静态头像)

# LiveKit SFU (实时音视频传输) — 缺失则 WS 降级
FUSION_K12_LIVEKIT_URL=ws://127.0.0.1:7880
FUSION_K12_LIVEKIT_API_KEY=devkey
FUSION_K12_LIVEKIT_API_SECRET=devsecret1234567890abcd

# fusion-mlx 源码路径 (MuseTalk in-process 导入) — 缺失则降级 StaticAvatar
FUSION_MLX_SOURCE=/Users/dahai/fusion/fusion-mlx

# fusion-mlx LLM/TTS/ASR 网关
FUSION_MLX_URL=http://localhost:11432/v1
FUSION_MLX_MODEL=mlx-community--Qwen3-8B-4bit
FUSION_MLX_API_KEY=

# 生产串行 — 限制同时 in-flight 的 MLX 推理请求数 (chat/stream/TTS/ASR 共享)。
# 本地单卡防 OOM/排队雪崩。1=严格串行 (生产推荐), 4=并发 (开发默认)。
FUSION_MLX_MAX_CONCURRENCY=1

# Qwen3 thinking 模式 — 默认关闭 (enable_thinking=false), 复杂 prompt 快速响应。
# 教学场景无需 reasoning, 开启会生成数分钟 reasoning_content 致超时。true=开。
FUSION_MLX_ENABLE_THINKING=

# ── 生产加固 (商用部署必配, 详见 docs/commercial-acceptance-2026-10-12.md issue #27) ──

# 每 IP 滑动窗口限流 "N次/秒" — 单 teacher key 泄漏时不至于打穿本地 LLM。留空=不限。
# 本地启动即可配 (改数值走热更文件, 不用重启); 也可启动后经热更文件开关。
FUSION_K12_RATE_LIMIT=60/60

# 配置热更文件 (KEY=VALUE, 模板见 config/runtime.example) — 模型/限流/盐/日志级
# 四项白名单改动保存即生效, 免重启。生产/集群部署强烈建议启用。
# FUSION_K12_CONFIG_FILE=config/runtime

