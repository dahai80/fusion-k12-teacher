# Fusion-K12-Teacher 环境变量样例 — 复制为 .env 按需修改
# 完整说明见 docs/deploy.md 配置说明章节

# ── LLM 后端 (fusion-gateway / fusion-mlx) ──
FUSION_MLX_URL=http://localhost:11432/v1
FUSION_MLX_MODEL=
FUSION_MLX_API_KEY=
FUSION_MLX_CONNECT_TIMEOUT=10
FUSION_MLX_READ_TIMEOUT=120
FUSION_MLX_MAX_RETRIES=2
FUSION_MLX_MAX_CONCURRENCY=4
FUSION_MLX_MODELS_TTL=30

# ── HTTP API ──
FUSION_K12_PORT=11448
FUSION_K12_API_KEY=
FUSION_K12_ADMIN_API_KEY=
FUSION_K12_RATE_LIMIT=60
FUSION_K12_RATE_WINDOW=60
FUSION_K12_RATE_STATE_FILE=

# ── 数据 / 持久化 ──
FUSION_K12_HOME=~/.fusion-k12
FUSION_K12_HISTORY_FILE=
FUSION_K12_SCHEDULER_DB=
FUSION_K12_SCHEDULER_PIDFILE=
FUSION_K12_INSTANCE_LOCK=
FUSION_K12_DATA_DIR=

# ── 脱敏 / 安全 ──
# 多节点部署务必统一分发 salt, 否则同一学生跨节点 ID 断链
FUSION_K12_SALT=
FUSION_K12_SALT_FILE=
FUSION_K12_NAME_MAP_FILE=

# ── 调度 / 日志 / 测试 ──
FUSION_K12_CRON_RETRIES=1
LOG_LEVEL=INFO
FUSION_K12_LIVE_TESTS=0
